NODE_ENV=development
PORT=3000
# Reverse-proxy hops in front of the app whose X-Forwarded-For is trusted for the
# client IP (used by the failed-auth rate limit). 0 trusts none. Cloud Run / a single
# load balancer needs 1. Never set higher than the real number of proxies.
TRUST_PROXY_HOPS=0
# PostgreSQL connection (matches docker-compose.yml). DB_PASSWORD is a secret: no default.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=praxis

# Firebase Authentication (placeholder values; use your own project id)
FIREBASE_PROJECT_ID=praxis-dev-placeholder
# Optional service-account JSON (secret). Omit on Cloud Run/GKE (ADC is used).
# FIREBASE_CREDENTIALS_JSON={"type":"service_account", ...}
# Local Firebase Auth emulator only; the app refuses to boot with this in production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Recognised consent document versions (comma-separated, required, no defaults).
# PLACEHOLDERS: the real Terms / Privacy Policy identifiers come from the product owner.
CONSENT_TERMS_VERSIONS=TERMS-PLACEHOLDER-1
CONSENT_PRIVACY_VERSIONS=PRIVACY-PLACEHOLDER-1

# Password reset (all PLACEHOLDERS; use your own values, never commit real ones)
# Trusted app origin the emailed reset link points at (scheme + host, no path).
# https is required when NODE_ENV=production. Never taken from a request header.
APP_BASE_URL=http://localhost:8081
# Resend API key (secret, required, no default).
RESEND_API_KEY=re_PLACEHOLDER_not_a_real_key
# Sender address on a Resend-verified domain (plain address, required).
PASSWORD_RESET_EMAIL_FROM=no-reply@mail.example.test
# Optional rate limit for POST /api/v1/auth/password-reset only, per client IP.
# PASSWORD_RESET_RATE_LIMIT=5
# PASSWORD_RESET_RATE_WINDOW_MS=60000

# OpenAI API key for the chat patient agents (secret, required, no default). PLACEHOLDER:
# create your own key and never commit a real one. Tests use dummy values and never call OpenAI.
OPENAI_API_KEY=sk-PLACEHOLDER-not-a-real-key

# CORS for browser clients (the Expo web app). Comma-separated list of exact origins
# (scheme + host[:port], no path). Unset or empty disables CORS. "*" is allowed for
# local development only; the app refuses to boot with it when NODE_ENV=production.
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Seconds a browser may cache a preflight answer (0-86400, default 600).
# CORS_MAX_AGE_SECONDS=600
